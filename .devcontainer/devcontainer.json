{
  "name": "Taqsimlangan tizimlar — Amaliy 1",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "forwardPorts": [8081, 8082, 8083, 8084, 8085],
  "portsAttributes": {
    "8081": { "label": "tugun1" },
    "8082": { "label": "tugun2" },
    "8083": { "label": "tugun3" },
    "8084": { "label": "tugun4" },
    "8085": { "label": "tugun5" }
  },
  "postCreateCommand": "chmod +x *.sh && docker --version && docker compose version",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 2
  }
}
